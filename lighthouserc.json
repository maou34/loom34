{
  "ci": {
    "collect": {
      "url": [
        "https://lgbt-loom.fr/",
        "https://lgbt-loom.fr/events",
        "https://lgbt-loom.fr/articles",
        "https://lgbt-loom.fr/about",
        "https://lgbt-loom.fr/photos",
        "https://lgbt-loom.fr/partners",
        "https://lgbt-loom.fr/monsieur-ours"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "blockedUrlPatterns": ["*cloudflareinsights*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.25 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lighthouse-reports"
    }
  }
}
