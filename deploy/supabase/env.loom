# Valeurs LOOM à reporter dans /opt/supabase/.env APRÈS `setup.sh` (qui génère
# les secrets). Ne contient aucun secret : les mots de passe et clés restent
# ceux générés sur le serveur. Voir deploy/supabase/README.md, étape 4.

COMPOSE_FILE=docker-compose.yml:docker-compose.loom.yml

# Adresses publiques
SUPABASE_PUBLIC_URL=https://api.lgbt-loom.fr
API_EXTERNAL_URL=https://api.lgbt-loom.fr/auth/v1

# Studio
STUDIO_DEFAULT_ORGANIZATION=LOOM
STUDIO_DEFAULT_PROJECT=LOOM

# Auth : comme la prod en ligne (inscriptions fermées, comptes par invitation)
SITE_URL=https://lgbt-loom.fr
ADDITIONAL_REDIRECT_URLS=https://lgbt-loom.fr/auth/update-password,http://localhost:8080/auth/update-password
DISABLE_SIGNUP=true
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false

# SMTP : Gmail de l'association (mot de passe d'application), port 465 (TLS direct)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_ADMIN_EMAIL=<adresse Gmail de l'association>
SMTP_USER=<adresse Gmail de l'association>
SMTP_PASS=<mot de passe d'application Gmail>
SMTP_SENDER_NAME=LOOM

# Fonctions : chacune vérifie elle-même l'appelant
FUNCTIONS_VERIFY_JWT=false
FUNCTIONS_MEMORY_LIMIT=1g
