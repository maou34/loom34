# Modèle de /opt/supabase/functions.env (secrets des Edge Functions LOOM).
# Copier en functions.env, remplir, puis : chmod 600 functions.env
# Jamais dans git. Mêmes noms que les `supabase secrets` du projet en ligne.

# HelloAsso (sandbox pendant les essais, production à la bascule)
HELLOASSO_API_URL=https://api.helloasso-sandbox.com
HELLOASSO_CLIENT_ID=
HELLOASSO_CLIENT_SECRET=
HELLOASSO_ORG_SLUG=loom-test
HELLOASSO_PUBLISH_MODE=draft
# HELLOASSO_IMPORT_CREATED_AFTER=2026-12-01
HELLOASSO_WEBHOOK_SECRET=

# Secrets partagés avec la base (mêmes valeurs que dans le Vault de cette instance)
SYNC_EVENTS_SECRET=
NOTIFY_MESSAGE_SECRET=

# E-mails de notification des messages (Gmail de l'association, mot de passe d'application)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Tableau de bord de l'admin (facultatifs : sans eux, les blocs affichent une invite)
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_SITE_TAG=
UPTIMEROBOT_API_KEY=
