# Copier en .env.local (jamais committé) et remplir.
# Seules les variables VITE_… arrivent dans le navigateur : jamais de clé secrète ici.
VITE_SUPABASE_URL=https://<projet>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé publique anon>

# Facultatif
# VITE_UPLOAD_URL=http://localhost:8081
# VITE_HELLOASSO_BASE_URL=https://www.helloasso-sandbox.com
# VITE_HELLOASSO_ORG_SLUG=<organisation HelloAsso>

# Serveur de photos (npm run server:upload) : reprend les VITE_SUPABASE_* ci-dessus à défaut
# SUPABASE_URL=https://<projet>.supabase.co
# SUPABASE_ANON_KEY=<clé publique anon>
